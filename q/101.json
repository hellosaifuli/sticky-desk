[["بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْقَارِعَةُ","করাঘাতকারী"],["مَا الْقَارِعَةُ","করাঘাতকারী কি"],["وَمَا أَدْرَاكَ مَا الْقَارِعَةُ","করাঘাতকারী সম্পর্কে আপনি কি জানেন"],["يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ","যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত"],["وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ","এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।"],["فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ","অতএব যার পাল্লা ভারী হবে"],["فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ","সে সুখীজীবন যাপন করবে।"],["وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ","আর যার পাল্লা হালকা হবে"],["فَأُمُّهُ هَاوِيَةٌ","তার ঠিকানা হবে হাবিয়া।"],["وَمَا أَدْرَاكَ مَا هِيَهْ","আপনি জানেন তা কি"],["نَارٌ حَامِيَةٌ","প্রজ্জ্বলিত অগ্নি"]]